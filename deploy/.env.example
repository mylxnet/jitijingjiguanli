# 集体台账 · Docker 部署环境变量
# 复制为 .env 后修改，.env 不要提交到 Git

# 监听端口（宿主机映射）
APP_PORT=8080

# 数据持久化目录（挂载到容器 /data，SQLite 数据库文件存放于此）
# 飞牛 NAS 建议放到 /volume1/docker/jititaizhang/data
DATA_DIR=./data

# 备份目录（挂载到容器 /backups）
# 飞牛 NAS 建议放到 /volume1/docker/jititaizhang/backups
APP_BACKUP_DIR=./backups

# 备份保留份数（默认 30）
APP_KEEP_BACKUP=30

# 是否启用每日 03:00 自动备份（1=启用，0=关闭）
APP_AUTO_BACKUP=1